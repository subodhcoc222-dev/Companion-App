<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF090D16"
    android:padding="24dp"
    android:keepScreenOn="true">

    <!-- Top Status Indicator -->
    <TextView
        android:id="@+id/tvLockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 DESK SENTRY BREACH"
        android:textColor="#FFFF3344"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <!-- Reason Box Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#22FF3344"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvLockStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBreachTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMPER DETECTED"
                android:textColor="#FFFF6B7A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBreachReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Camera Phone Unplugged or Disconnected!"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Plug in camera phone charger\n• Ensure Sentry app is active on desk\n• Swipe down notification drawer to turn on Hotspot if Wi-Fi dropped"
                android:textColor="#FFB0B8C4"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Auto-Clear Status Notice -->
    <TextView
        android:id="@+id/tvAutoClearNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🔄 Waiting for Sentry Heartbeat...\nSystem will automatically unlock as soon as Sentry phone goes back online."
        android:textColor="#FF00E676"
        android:textAlignment="center"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardReason"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Emergency PIN Section -->
    <LinearLayout
        android:id="@+id/layoutPinSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etEmergencyPin"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="#1E293B"
            android:hint="Enter Master PIN"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:textAlignment="center"
            android:letterSpacing="0.2"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnUnlockEmergency"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Emergency Unlock"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
